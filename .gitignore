# dependencies
node_modules/

# builds
dist/
build/
.next/
.turbo/

# env — never commit real values (names only in .env.example)
.env
.env.*
!.env.example

# databases (local SQLite lives in packages/db)
*.db
*.db-journal

# prisma client output (Prisma resolves `output` relative to schema.prisma)
packages/db/prisma/generated/

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# logs
*.log
pnpm-debug.log*

# raw downloaded data (reproducible via HDX; do not commit large CSVs)
data/
